# GeoTalk Car Voice WebRTC - Environment Variables
# Janus Gateway & Backend Configuration

# ================================
# Backend Configuration
# ================================
NODE_ENV=development
PORT=5000

# ================================
# MongoDB Configuration
# ================================
MONGODB_URI=mongodb://mongodb:27017/carvoice

# ================================
# JWT Configuration
# ================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# ================================
# CORS Configuration
# ================================
CORS_ORIGIN=http://localhost:3000,https://localhost:3001

# ================================
# Janus Gateway Configuration
# ================================
# Janus HTTP API URL (Docker internal)
JANUS_HTTP_URL=http://janus:8088/janus

# Janus WebSocket URL (Docker internal for backend)
JANUS_WS_URL=ws://janus:8188

# Janus Admin API URL
JANUS_ADMIN_URL=http://janus:8989/admin

# Janus API Secrets
JANUS_API_SECRET=carvoice_janus_secret
JANUS_ADMIN_SECRET=carvoice_janus_admin

# ================================
# STUN/TURN Server Configuration
# ================================
# STUN Server (Google public STUN)
STUN_SERVER=stun.l.google.com:19302

# TURN Server (Coturn)
TURN_SERVER=turn:localhost:3478
TURN_USER=carvoice
TURN_SECRET=carvoice_turn_secret_2024

# Host IP (Docker için public IP)
HOST_IP=127.0.0.1

# ================================
# Redis Configuration (Optional)
# ================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=info