# GeoTalk Car Voice WebRTC - Frontend Environment Variables

# ================================
# API Configuration
# ================================
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_SOCKET_URL=ws://localhost:5000

# ================================
# Janus Gateway Configuration (Client)
# ================================
# Janus WebSocket URL (accessible from browser)
REACT_APP_JANUS_WS_URL=ws://localhost:8188

# Janus HTTP URL (for fallback)
REACT_APP_JANUS_HTTP_URL=http://localhost:8088/janus

# ================================
# Map Configuration
# ================================
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
REACT_APP_MAP_CENTER_LAT=39.9334
REACT_APP_MAP_CENTER_LNG=32.8597
REACT_APP_MAP_ZOOM=13

# ================================
# Feature Flags
# ================================
# Enable Janus SFU (default: true)
REACT_APP_USE_JANUS=true

# Enable P2P fallback if Janus fails (default: true)
REACT_APP_ENABLE_P2P_FALLBACK=true

# ================================
# WebRTC Configuration
# ================================
REACT_APP_AUDIO_ECHO_CANCELLATION=true
REACT_APP_AUDIO_NOISE_SUPPRESSION=true
REACT_APP_AUDIO_AUTO_GAIN_CONTROL=true

# ================================
# Build Configuration
# ================================
GENERATE_SOURCEMAP=false
