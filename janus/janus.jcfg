# Janus Gateway ana konfigürasyon dosyası
# GeoTalk Car Voice WebRTC projesi için optimize edilmiş

general: {
	# Genel ayarlar
	configs_folder = "/opt/janus/etc/janus"
	plugins_folder = "/opt/janus/lib/janus/plugins"
	transports_folder = "/opt/janus/lib/janus/transports"
	events_folder = "/opt/janus/lib/janus/events"
	loggers_folder = "/opt/janus/lib/janus/loggers"
	
	# API konfigürasyonu
	api_secret = "carvoice_janus_secret"
	admin_secret = "carvoice_janus_admin"
	
	# Session timeout (saniye)
	session_timeout = 60
	
	# WebRTC için STUN/TURN sunucuları
	stun_server = "stun.l.google.com"
	stun_port = 19302
	nice_debug = false
	full_trickle = true
	
	# Ses codec'leri için optimize edilmiş ayarlar
	# Voice chat için öncelikli codec'ler: Opus > G.722 > PCMU
	# ignore_unreachable_ice_server = true
}

# Sertifikalar (self-signed)
certificates: {
	cert_pem = "/opt/janus/share/janus/certs/mycert.pem"
	cert_key = "/opt/janus/share/janus/certs/mycert.key"
	cert_pwd = ""
	dtls_mtu = 1200
}

# Media konfigürasyonu - Ses odaklı optimizasyon
media: {
	# Ses için optimize edilmiş ayarlar
	# IPv4/IPv6 desteği
	ipv6 = false
	
	# ICE ayarları
	ice_enforce_list = "stun.l.google.com:19302"
	ice_ignore_list = ""
	
	# DTLS ayarları
	dtls_timeout = 30000
	
	# RTP/RTCP portları
	rtp_port_range = "10000-10200"
	
	# Ses için düşük latency ayarları
	min_nack_queue = 50
	rtp_timeout = 60
	
	# Ses codec ayarları
	opfec = true
	audio_level_average = 25
	audio_active_packets = 25
}

# NAT ayarları
nat: {
	# Docker environment için
	stun_server = "stun.l.google.com"
	stun_port = 19302
	nice_debug = false
	ice_lite = false
	ice_tcp = true
	
	# TURN sunucusu (coturn ile entegrasyon)
	turn_server = "turn:coturn:3478"
	turn_user = "carvoice"
	turn_pwd = "carvoice_turn_secret_2024"
	turn_type = "udp"
	
	# Public IP (Docker container için)
	# nat_1_1_mapping = "HOST_IP_PLACEHOLDER"
}

# Plugin'ler
plugins: {
	disable = []
}

# Transport'lar
transports: {
	disable = []
}

# Event handlers
events: {
	broadcast = true
}

# Log ayarları
log: {
	# Log level: 0=disable, 1=fatal, 2=error, 3=warn, 4=info, 5=verb, 6=debug, 7=huge
	debug_level = 4
	debug_timestamps = true
	debug_colors = false
	debug_locks = false
}
